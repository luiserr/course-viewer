# ─── Despliegue (solo lo usa scripts/build-deploy.mjs, no llega al navegador) ───

# Raíz del clon que contiene la carpeta School (sin barra final).
# Ejemplo: C:\Users\LuisEduardoRiveroRom\Workspace\LXP\schoolCode
LXP_SCHOOL_CODE_ROOT=

# Opcional. Ruta del módulo relativa a LXP_SCHOOL_CODE_ROOT.
# Por defecto: School/content_viewer_v3
# LXP_TARGET_RELATIVE_PATH=School/content_viewer_v3


# ─── Backend al que apunta `npm run dev` ───

# Target del proxy del servidor de desarrollo. El front siempre pide /api/...;
# esta variable decide a qué backend se traduce.
#
#   Local (por defecto):  http://saberesmx.pruebas.local/src
#   Pruebas:              https://saberesmx-pruebas.territorio.la/src
#   Producción:           https://saberes.gob.mx/src
#
# VITE_API_PROXY_TARGET=http://saberesmx.pruebas.local/src

# Cookie de sesión del backend, necesaria SOLO si VITE_API_PROXY_TARGET apunta a
# un entorno remoto: el navegador no manda a localhost las cookies de otro
# dominio, así que el proxy las inyecta por ti. Sin esto la app queda en modo
# invitado (sin sesión y sin JWT, o sea sin árbol de curso).
#
# Cómo obtenerla:
#   1. Inicia sesión en el entorno remoto en tu navegador.
#   2. DevTools → Application → Cookies → el dominio (p.ej. saberes.gob.mx).
#   3. Copia el par completo, por ejemplo: PHPSESSID=8f3c...  (varios pares van
#      separados por "; ").
#
# Es una sesión viva: trátala como una credencial, caduca, y este archivo está
# en .gitignore por eso mismo.
# VITE_BACKEND_COOKIE=PHPSESSID=pon-aqui-tu-sesion

# Opcional. Fuerza la URL base de la API en el código del front (ignora la
# detección por hostname). Solo aplica a builds servidos fuera de su dominio.
# VITE_API_BASE_URL=https://saberesmx-pruebas.territorio.la/src
